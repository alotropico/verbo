          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "to": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string",
        },
        "toDirectory": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "description": "Rename a file or folder inside its current folder. One collision-free rename runs immediately. Several renames wait for confirmation. Changing folders is files.move. Swaps and cycles are rejected.",
    "example": {
      "from": "tmp:/draft.md",
      "to": "tmp:/final.md",
    },
    "id": "files.rename",
    "kind": "mutation",
    "syntax": "{from, to} or {items:[{from, to}]} or {resultSet, toDirectory}",
  },
